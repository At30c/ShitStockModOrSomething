 arch/arm64/boot/dts/exynos/exynos9830-ems.dtsi | 28 +++++++++++-----------
 1 file changed, 14 insertions(+), 14 deletions(-)

diff --git a/arch/arm64/boot/dts/exynos/exynos9830-ems.dtsi b/arch/arm64/boot/dts/exynos/exynos9830-ems.dtsi
--- a/arch/arm64/boot/dts/exynos/exynos9830-ems.dtsi
+++ b/arch/arm64/boot/dts/exynos/exynos9830-ems.dtsi
@@ -301,11 +301,11 @@
 						domain1 {
 							cpus = "4-5";
 							lower-boundary = <106>;
-							upper-boundary = <586>;
+							upper-boundary = <820>;
 						};
 						domain2 {
 							cpus = "6-7";
-							lower-boundary = <205>;
+							lower-boundary = <500>;
 							upper-boundary = <1024>;
 						};
 					};
