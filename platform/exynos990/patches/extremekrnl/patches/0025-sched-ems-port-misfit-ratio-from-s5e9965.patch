@@ -406,6 +407,64 @@ parse_sched_policy(struct device_node *dn, struct emstune_set *set)
 /******************************************************************************
  * efficiency weight                                                          *
  ******************************************************************************/
+/******************************************************************************
+ * misfit ratio                                                               *
+ ******************************************************************************/
+static int misfit_ratio_of(int cpu, int group)
+{
+	int ratio = cur_set.misfit_ratio.ratio[cpu][group];
+
+	return ratio > 0 ? ratio : DEFAULT_MISFIT_RATIO;
+}
+
+int emstune_misfit_ratio(struct task_struct *p, int cpu)
+{
+	if (unlikely(!emstune_initialized))
+		return DEFAULT_MISFIT_RATIO;
+
+	return misfit_ratio_of(cpu, schedtune_task_group_idx(p));
+}
+
+/* Overutilized above the lowest ratio of the groups (S5E9965 semantics). */
+bool ems_cpu_overutilized(int cpu, unsigned long capacity, unsigned long util)
+{
+	int group, ratio = 100;
+
+	if (unlikely(!emstune_initialized))
+		return cpu_overutilized(capacity, util);
+
+	for (group = 0; group < STUNE_GROUP_COUNT; group++)
+		ratio = min(ratio, misfit_ratio_of(cpu, group));
+
+	return capacity * ratio < util * 100;
+}
+
+static int
+parse_misfit_ratio(struct device_node *dn, struct emstune_set *set)
+{
+	struct emstune_misfit_ratio *misfit_ratio = &set->misfit_ratio;
+	int cpu, group;
+	int val[NR_CPUS];
+
+	if (!dn)
+		return 0;
+
+	for (group = 0; group < STUNE_GROUP_COUNT; group++) {
+		if (of_property_read_u32_array(dn,
+				stune_group_name[group], val, NR_CPUS))
+			return -EINVAL;
+
+		for_each_possible_cpu(cpu)
+			misfit_ratio->ratio[cpu][group] = val[cpu];
+	}
+
+	misfit_ratio->overriding = true;
+
+	of_node_put(dn);
+
+	return 0;
+}
+
 #define DEFAULT_WEIGHT	(100)
 int emstune_eff_weight(struct task_struct *p, int cpu, int idle)
 {
@@ -1470,6 +1529,20 @@ show_cur_set(struct kobject *k, struct kobj_attribute *attr, char *buf)
 	}
