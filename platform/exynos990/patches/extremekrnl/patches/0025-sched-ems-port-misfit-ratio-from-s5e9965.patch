+	ret += sprintf(buf + ret, "\n");
+	for_each_possible_cpu(cpu) {
+		ret += sprintf(buf + ret, "cpu%d:", cpu);
+		for (group = 0; group < STUNE_GROUP_COUNT; group++)
+			ret += sprintf(buf + ret, "%5d",
+					cur_set.misfit_ratio.ratio[cpu][group]);
+		ret += sprintf(buf + ret, "\n");
+	}
+	ret += sprintf(buf + ret, "\n");
+
 	ret += sprintf(buf + ret, "[freq-boost]\n");
 	ret += sprintf(buf + ret, "     ");
 	for (group = 0; group < STUNE_GROUP_COUNT; group++)
@@ -2154,6 +2227,7 @@ emstune_set_init(struct device_node *dn, struct emstune_set *set)
 	parse(migov);
 	parse(fmax);
 	parse(ecs);
+	parse(misfit_ratio);
 
 	return 0;
 }
