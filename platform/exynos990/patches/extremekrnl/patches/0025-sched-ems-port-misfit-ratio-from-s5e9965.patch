diff --git a/kernel/sched/ems/ems.h b/kernel/sched/ems/ems.h
index f8adbda..0c45809 100644
--- a/kernel/sched/ems/ems.h
+++ b/kernel/sched/ems/ems.h
@@ -262,6 +262,19 @@ struct emstune_ecs {
 	struct kobject kobj;
 };
 
+/*
+ * emstune - misfit ratio (from the S5E9965 EMS): a task fits a cpu while its
+ * util is below ratio % of the cpu capacity, per cpu and schedtune group;
+ * a cpu is overutilized above the lowest ratio of its groups. 0 = 80%.
+ */
+#define DEFAULT_MISFIT_RATIO	80
+
+struct emstune_misfit_ratio {
+	bool overriding;
+	int ratio[NR_CPUS][STUNE_GROUP_COUNT];
+	struct kobject kobj;
+};
+
 struct emstune_set {
 	int				idx;
 	const char			*desc;
@@ -281,6 +294,7 @@ struct emstune_set {
 	struct emstune_migov		migov;
 	struct emstune_fmax		fmax;
 	struct emstune_ecs		ecs;
+	struct emstune_misfit_ratio	misfit_ratio;
 
 	struct kobject	  		kobj;
 };
@@ -297,6 +311,8 @@ struct emstune_mode {
 
 extern bool emstune_can_migrate_task(struct task_struct *p, int dst_cpu);
 extern int emstune_eff_weight(struct task_struct *p, int cpu, int idle);
+extern int emstune_misfit_ratio(struct task_struct *p, int cpu);
+extern bool ems_cpu_overutilized(int cpu, unsigned long capacity, unsigned long util);
 extern const struct cpumask *emstune_cpus_allowed(struct task_struct *p);
 extern int emstune_sched_policy(struct task_struct *p);
 extern int emstune_ontime(struct task_struct *p);
