--- a/kernel/sched/ems/tune.c
+++ b/kernel/sched/ems/tune.c
@@ -66,6 +66,7 @@
 }
 
 static void emstune_fmax_schedule(void);
+static void emstune_ecs_apply(void);
 
 #define default_set cur_mode->sets[0]
 #define update_cur_set_field(_member)					\
@@ -96,9 +97,11 @@
 	update_cur_set_field(frt);
 	update_cur_set_field(migov);
 	update_cur_set_field(fmax);
+	update_cur_set_field(ecs);
 
 	emstune_notify_mode_update();
 	emstune_fmax_schedule();
+	emstune_ecs_apply();
 }
 
 static struct mutex emstune_mode_lock;
@@ -1212,6 +1215,66 @@
 	return 0;
 }
 
+/******************************************************************************
+ * core sparing per set							      *
+ *									      *
+ * Like the per-set ECS of the S5E9965 EMS, a set may turn core sparing on:   *
+ * while few cpus are busy, tasks stay on the cpus of the ECS saving mode and *
+ * the other cluster can power down. Sets without an ecs node inherit the     *
+ * mode's default set; the ECS governor itself needs the /ems/ecs DT node.    *
+ ******************************************************************************/
+static int ecs_allowed = 1;
+
+/* Called with emstune_mode_lock held; ecs_emstune_update() only spins. */
+static void emstune_ecs_apply(void)
+{
+	ecs_emstune_update(ecs_allowed && cur_set.ecs.enabled);
+}
+
+static int
+parse_ecs(struct device_node *dn, struct emstune_set *set)
+{
+	u32 val;
+
+	if (!dn)
+		return 0;
+
+	if (of_property_read_u32(dn, "enabled", &val))
+		val = 0;
+
+	set->ecs.enabled = !!val;
+	set->ecs.overriding = true;
+
+	of_node_put(dn);
+
+	return 0;
+}
+
+static ssize_t
+show_ecs_enabled(struct kobject *k, struct kobj_attribute *attr, char *buf)
+{
+	return sprintf(buf, "%d\n", ecs_allowed);
+}
+
+static ssize_t
+store_ecs_enabled(struct kobject *k, struct kobj_attribute *attr,
+		const char *buf, size_t count)
+{
+	int val;
+
+	if (kstrtoint(buf, 10, &val))
+		return -EINVAL;
+
+	mutex_lock(&emstune_mode_lock);
+	ecs_allowed = !!val;
+	emstune_ecs_apply();
+	mutex_unlock(&emstune_mode_lock);
+
+	return count;
+}
+static struct kobj_attribute ecs_enabled_attr =
+__ATTR(ecs_enabled, 0644, show_ecs_enabled, store_ecs_enabled);
+
 static ssize_t
 show_fmax_enabled(struct kobject *k, struct kobj_attribute *attr, char *buf)
 {
@@ -1510,6 +1573,8 @@
 	for_each_possible_cpu(cpu)
 		ret += sprintf(buf + ret, "cpu%d: %u\n",
 				cpu, cur_set.fmax.max_freq[cpu]);
+	ret += sprintf(buf + ret, "\n[ecs] enabled: %d (allowed=%d)\n",
+			cur_set.ecs.enabled, ecs_allowed);
 
 	ret += sprintf(buf + ret, "\n");
 
@@ -2044,6 +2109,7 @@
 	parse(frt);
 	parse(migov);
 	parse(fmax);
+	parse(ecs);
 
 	return 0;
 }
@@ -2150,6 +2216,9 @@
 	if (sysfs_create_file(emstune_kobj, &fmax_enabled_attr.attr))
 		return -ENOMEM;
 
+	if (sysfs_create_file(emstune_kobj, &ecs_enabled_attr.attr))
+		return -ENOMEM;
+
 	return 0;
 }
 
