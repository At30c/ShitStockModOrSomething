 };
 
+/* emstune - core sparing (ECS): spare the cpus outside the saving mode */
+struct emstune_ecs {
+	bool overriding;
+	int enabled;
+	struct kobject kobj;
+};
+
 struct emstune_set {
 	int				idx;
 	const char			*desc;
@@ -259,6 +267,7 @@
 	struct emstune_frt		frt;
 	struct emstune_migov		migov;
 	struct emstune_fmax		fmax;
+	struct emstune_ecs		ecs;
 
