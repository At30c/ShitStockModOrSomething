+
+	seq_printf(m, "size=%u vlen=%u", t->size, nr_vsi);
+	for (i = 0; i < nr_vsi; i++)
+		seq_printf(m, " [%u %u %u]", vsi[i].type, vsi[i].offset,
+			   vsi[i].size);
+}
