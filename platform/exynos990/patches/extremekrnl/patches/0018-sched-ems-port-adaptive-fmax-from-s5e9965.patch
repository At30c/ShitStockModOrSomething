 	ret += sprintf(buf + ret, "migov_en: %d\n", cur_set.migov.migov_en);
+	ret += sprintf(buf + ret, "\n");
+
+	ret += sprintf(buf + ret, "[fmax] (kHz, 0 = no ceiling, enabled=%d)\n",
+			fmax_enabled);
+	for_each_possible_cpu(cpu)
+		ret += sprintf(buf + ret, "cpu%d: %u\n",
+				cpu, cur_set.fmax.max_freq[cpu]);
 
 	ret += sprintf(buf + ret, "\n");
 
@@ -1892,6 +2043,7 @@
 	parse(init_util);
 	parse(frt);
 	parse(migov);
+	parse(fmax);
 
 	return 0;
 }
@@ -1995,6 +2147,9 @@
 	if (sysfs_create_file(emstune_kobj, &hungry_attr.attr))
 		return -ENOMEM;
 
+	if (sysfs_create_file(emstune_kobj, &fmax_enabled_attr.attr))
+		return -ENOMEM;
+
 	return 0;
 }
 
