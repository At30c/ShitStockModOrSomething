 /******************************************************************************
+ * adaptive fmax							      *
+ *									      *
+ * Each set may cap the frequency of every coregroup, like the adaptive fmax  *
+ * of the S5E9965 EMS: everyday sets keep the big cluster below its maximum   *
+ * and the boost/game sets lift the ceiling. The ceiling is a PM QoS max      *
+ * request per cluster, so thermal and other max requests still combine with  *
+ * it (the lowest wins). Coregroups map to PM_QOS_CLUSTER0..2_FREQ_MAX in     *
+ * order, matching the exynos-acme pm_qos-max-class of each domain.	      *
+ ******************************************************************************/
+#define FMAX_MAX_GROUPS	3
+
+static const int fmax_qos_class[FMAX_MAX_GROUPS] = {
+	PM_QOS_CLUSTER0_FREQ_MAX,
+	PM_QOS_CLUSTER1_FREQ_MAX,
+	PM_QOS_CLUSTER2_FREQ_MAX,
+};
+static struct pm_qos_request fmax_qos[FMAX_MAX_GROUPS];
+static int fmax_group_cpu[FMAX_MAX_GROUPS];
+static int fmax_group_count;
+static bool fmax_ready;
+static int fmax_enabled = 1;
+
+static void emstune_fmax_work_fn(struct work_struct *work)
+{
+	unsigned int freq[FMAX_MAX_GROUPS];
+	int i;
+
+	if (!READ_ONCE(fmax_ready))
+		return;
+
+	mutex_lock(&emstune_mode_lock);
+	for (i = 0; i < fmax_group_count; i++)
+		freq[i] = fmax_enabled ?
+			cur_set.fmax.max_freq[fmax_group_cpu[i]] : 0;
+	mutex_unlock(&emstune_mode_lock);
+
+	for (i = 0; i < fmax_group_count; i++)
+		pm_qos_update_request(&fmax_qos[i],
+			freq[i] ? (s32)freq[i] : PM_QOS_DEFAULT_VALUE);
+}
+static DECLARE_WORK(emstune_fmax_work, emstune_fmax_work_fn);
+
+/* May run with emstune_mode_lock held: PM QoS can sleep, so defer. */
+static void emstune_fmax_schedule(void)
+{
+	if (READ_ONCE(fmax_ready))
+		schedule_work(&emstune_fmax_work);
+}
+
+static void __init emstune_fmax_init(void)
+{
+	int cpu;
+
+	for_each_possible_cpu(cpu) {
+		if (cpu != cpumask_first(cpu_coregroup_mask(cpu)))
+			continue;
+		if (fmax_group_count == FMAX_MAX_GROUPS) {
+			pr_warn("emstune: adaptive fmax supports %d clusters\n",
+				FMAX_MAX_GROUPS);
+			break;
+		}
+		fmax_group_cpu[fmax_group_count] = cpu;
+		pm_qos_add_request(&fmax_qos[fmax_group_count],
+			fmax_qos_class[fmax_group_count], PM_QOS_DEFAULT_VALUE);
+		fmax_group_count++;
+	}
+
+	WRITE_ONCE(fmax_ready, true);
+	emstune_fmax_schedule();
+}
+
+static int
+parse_fmax(struct device_node *dn, struct emstune_set *set)
+{
+	struct emstune_fmax *fmax = &set->fmax;
+	int cpu, cursor, cnt, groups = 0;
+	u32 val[NR_CPUS];
+
+	if (!dn)
+		return 0;
+
+	for_each_possible_cpu(cpu)
+		if (cpu == cpumask_first(cpu_coregroup_mask(cpu)))
+			groups++;
+
+	cnt = of_property_count_u32_elems(dn, "max-freq");
+	if (cnt != groups ||
+	    of_property_read_u32_array(dn, "max-freq", val, cnt)) {
+		pr_err("emstune: set %s: fmax needs one max-freq per cluster\n",
+			set->desc);
+		of_node_put(dn);
+		return -EINVAL;
+	}
+
+	cnt = 0;
+	for_each_possible_cpu(cpu) {
+		if (cpu != cpumask_first(cpu_coregroup_mask(cpu)))
+			continue;
+
+		for_each_cpu(cursor, cpu_coregroup_mask(cpu))
+			fmax->max_freq[cursor] = val[cnt];
+
+		cnt++;
+	}
+
+	fmax->overriding = true;
+
+	of_node_put(dn);
+
+	return 0;
+}
+
+static ssize_t
+show_fmax_enabled(struct kobject *k, struct kobj_attribute *attr, char *buf)
+{
+	return sprintf(buf, "%d\n", fmax_enabled);
+}
+
+static ssize_t
+store_fmax_enabled(struct kobject *k, struct kobj_attribute *attr,
+		const char *buf, size_t count)
+{
+	int val;
+
+	if (kstrtoint(buf, 10, &val))
+		return -EINVAL;
+
+	mutex_lock(&emstune_mode_lock);
+	fmax_enabled = !!val;
+	mutex_unlock(&emstune_mode_lock);
+	emstune_fmax_schedule();
+
+	return count;
+}
+static struct kobj_attribute fmax_enabled_attr =
+__ATTR(fmax_enabled, 0644, show_fmax_enabled, store_fmax_enabled);
+
