 };
 
+/*
+ * emstune - adaptive fmax: per-coregroup frequency ceiling of the set,
+ * in kHz, 0 = no ceiling (ported from the S5E9965 EMS adaptive fmax).
+ */
+struct emstune_fmax {
+	bool overriding;
+	unsigned int max_freq[NR_CPUS];
+	struct kobject kobj;
+};
