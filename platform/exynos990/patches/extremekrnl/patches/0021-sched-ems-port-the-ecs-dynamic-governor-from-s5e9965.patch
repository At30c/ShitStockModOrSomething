diff --git a/include/trace/events/ems_debug.h b/include/trace/events/ems_debug.h
index f5baa5e..bfb29a4 100644
--- a/include/trace/events/ems_debug.h
+++ b/include/trace/events/ems_debug.h
@@ -651,6 +651,74 @@ TRACE_EVENT(ecs_update,
 		__entry->heavy_cpus, __entry->busy_cpus, __entry->cpus)
 );
 
+/*
+ * Tracepoints for the ecs dynamic governor (same format as the S5E9965 EMS)
+ */
+TRACE_EVENT(ecs_dynamic_cpu_info,
+
+	TP_PROTO(int cpu, unsigned long util, unsigned long cap,
+		 unsigned long busy_ratio, int curr_nr, int avg_nr, int avg_misfit),
+
+	TP_ARGS(cpu, util, cap, busy_ratio, curr_nr, avg_nr, avg_misfit),
+
+	TP_STRUCT__entry(
+		__field(	int,		cpu			)
+		__field(	unsigned long,	util			)
+		__field(	unsigned long,	cap			)
+		__field(	unsigned long,	busy_ratio		)
+		__field(	int,		curr_nr			)
+		__field(	int,		avg_nr			)
+		__field(	int,		avg_misfit		)
+	),
+
+	TP_fast_assign(
+		__entry->cpu			= cpu;
+		__entry->util			= util;
+		__entry->cap			= cap;
+		__entry->busy_ratio		= busy_ratio;
+		__entry->curr_nr		= curr_nr;
+		__entry->avg_nr			= avg_nr;
+		__entry->avg_misfit		= avg_misfit;
+	),
+
+	TP_printk("cpu=%1d, util=%lu, cap=%lu, busy_ratio=%lu, curr_nr=%1d, avg_nr=%1d, avg_misfit=%1d",
+		__entry->cpu, __entry->util, __entry->cap, __entry->busy_ratio,
+		__entry->curr_nr, __entry->avg_nr, __entry->avg_misfit)
+);
+
+TRACE_EVENT(ecs_dynamic_domain_info,
+
+	TP_PROTO(int domain, int required_cpus, int busy, int nr_run,
+		 int nr_misfit, int nr_busy_cpus, int nr_help),
+
+	TP_ARGS(domain, required_cpus, busy, nr_run, nr_misfit, nr_busy_cpus, nr_help),
+
+	TP_STRUCT__entry(
+		__field(	int,		domain			)
+		__field(	int,		required_cpus		)
+		__field(	int,		busy			)
+		__field(	int,		nr_run			)
+		__field(	int,		nr_misfit		)
+		__field(	int,		nr_busy_cpus		)
+		__field(	int,		nr_help			)
+	),
+
+	TP_fast_assign(
+		__entry->domain			= domain;
+		__entry->required_cpus		= required_cpus;
+		__entry->busy			= busy;
+		__entry->nr_run			= nr_run;
+		__entry->nr_misfit		= nr_misfit;
+		__entry->nr_busy_cpus		= nr_busy_cpus;
+		__entry->nr_help		= nr_help;
+	),
+
+	TP_printk("domain=%1d, required_cpus=%1d, busy=%d, nr_run=%1d, nr_misfit=%1d, nr_busy_cpus=%1d, nr_help=%1d",
+		__entry->domain, __entry->required_cpus, __entry->busy,
+		__entry->nr_run, __entry->nr_misfit, __entry->nr_busy_cpus,
+		__entry->nr_help)
+);
+
 /*
  * Tracepoint for frequency boost
  */
diff --git a/kernel/sched/ems/ems.h b/kernel/sched/ems/ems.h
index 7a49991..79efed8 100644
--- a/kernel/sched/ems/ems.h
+++ b/kernel/sched/ems/ems.h
@@ -128,7 +128,8 @@ extern unsigned int get_diff_num_levels(int cpu, unsigned int freq1, unsigned in
 
 /* core sparing */
 extern struct cpumask *ecs_cpus_allowed(void);
-extern void ecs_emstune_update(bool enable);
+struct emstune_ecs;
+extern void ecs_emstune_update(bool enable, const struct emstune_ecs *ecs);
 
 /* EMSTune */
 enum stune_group {
@@ -242,10 +243,21 @@ struct emstune_fmax {
 	struct kobject kobj;
 };
 
-/* emstune - core sparing (ECS): spare the cpus outside the saving mode */
+/*
+ * emstune - core sparing (ECS). With the ecs dynamic governor (ported from
+ * the S5E9965 EMS), a set may also tune it per ECS domain; -1 (or an absent
+ * min-cpus) keeps the default of the /ems/ecs/dynamic DT node.
+ */
+#define ECS_DYN_MAX_DOMAINS	4
+
 struct emstune_ecs {
 	bool overriding;
 	int enabled;
+	int busy_ratio[ECS_DYN_MAX_DOMAINS];
+	int nr_run_up_ratio[ECS_DYN_MAX_DOMAINS];
+	int help_misfit_thr[ECS_DYN_MAX_DOMAINS];
+	bool has_min_cpus;
+	struct cpumask min_cpus;
 	struct kobject kobj;
 };
 
diff --git a/kernel/sched/ems/sparing.c b/kernel/sched/ems/sparing.c
index 78b6be4..d584154 100644
--- a/kernel/sched/ems/sparing.c
+++ b/kernel/sched/ems/sparing.c
@@ -61,6 +61,234 @@ struct ecs_governor {
 
 static DEFINE_SPINLOCK(ecs_lock);
 static DEFINE_RAW_SPINLOCK(ecs_load_lock);
+
+/**********************************************************************************
+ *			ECS dynamic governor (from the S5E9965 EMS)		  *
+ *										  *
+ * Port of ecs_dynamic.c (S947B kernel source). Instead of fixed modes, every	  *
+ * tick each ECS domain gets the number of cpus it					  *
+ * needs: its own busy cpus, plus the tasks that do not fit in the smaller	  *
+ * domains that help it (nr-help: tasks beyond their cpu count, +1 when all of	  *
+ * them are busy; none while one of them still has a spared cpu), plus their	  *
+ * misfit tasks above help-misfit-thr (misfit-help). A domain with a spared cpu	  *
+ * is never busy.									  *
+ * Cpus are taken in order inside a domain, so one Mongoose core can be used	  *
+ * without the other. min-cpus are always available. Busy: util above		  *
+ * busy-ratio % of the cpu capacity (which follows the thermal/SIOP policy max)	  *
+ * or about three runnable tasks. Runnable and misfit counts are averages in	  *
+ * 1/1000 task, rounded up by nr-run-up-ratio (700: 0.3 task counts as one).	  *
+ * The S5E9965 reads them from its multi load tracker; here they are moving	  *
+ * averages sampled once per tick, from rq->nr_running and the misfit status	  *
+ * of the load balancer. The emstune set (ecs node) tunes the parameters.	  *
+ **********************************************************************************/
+#define ECS_DYN_BUSY_NR_RUN	3000	/* x1000: about three runnable tasks */
+#define ECS_DYN_AVG_SHIFT	2	/* moving average over ~4 ticks */
+
+struct ecs_dyn_domain {
+	struct cpumask		cpus;
+	int			nr_cpus;
+
+	/* helper domains (indexes) */
+	int			nr_help[ECS_DYN_MAX_DOMAINS];
+	int			nr_nr_help;
+	int			misfit_help[ECS_DYN_MAX_DOMAINS];
+	int			nr_misfit_help;
+
+	/* defaults from DT and the values of the current emstune set */
+	unsigned int		def_busy_ratio;
+	unsigned int		def_nr_run_up_ratio;
+	unsigned int		def_help_misfit_thr;
+	unsigned int		busy_ratio;
+	unsigned int		nr_run_up_ratio;
+	unsigned int		help_misfit_thr;
+
+	/* state of the last update */
+	bool			has_spared_cpu;
+	unsigned int		ratio;
+	int			busy;
+	int			nr_run;
+	int			nr_misfit;
+	int			nr_busy_cpus;
+	int			nr_help_cpus;
+	int			required_cpus;
+};
+
+static struct {
+	bool			enabled;
+	int			nr_domains;
+	struct ecs_dyn_domain	domains[ECS_DYN_MAX_DOMAINS];
+	struct cpumask		def_min_cpus;
+	struct cpumask		min_cpus;
+	unsigned long		last_update;
+} ecs_dyn;
+
+static DEFINE_PER_CPU(unsigned int, ecs_dyn_avg_nr);
+static DEFINE_PER_CPU(unsigned int, ecs_dyn_avg_misfit);
+
+static inline void ecs_dyn_avg(unsigned int *avg, unsigned int sample)
+{
+	int diff = (int)sample - (int)*avg;
+
+	*avg += diff >> ECS_DYN_AVG_SHIFT;
+	/* the shift truncates toward minus infinity; let it reach zero */
+	if (!sample && *avg < (1 << ECS_DYN_AVG_SHIFT))
+		*avg = 0;
+}
+
+/* Called with ecs_load_lock held. */
+static void ecs_dynamic_set_params(const struct emstune_ecs *ecs)
+{
+	int i;
+
+	for (i = 0; i < ecs_dyn.nr_domains; i++) {
+		struct ecs_dyn_domain *dom = &ecs_dyn.domains[i];
+
+		dom->busy_ratio = (ecs && ecs->busy_ratio[i] >= 0) ?
+				ecs->busy_ratio[i] : dom->def_busy_ratio;
+		dom->nr_run_up_ratio = (ecs && ecs->nr_run_up_ratio[i] >= 0) ?
+				ecs->nr_run_up_ratio[i] : dom->def_nr_run_up_ratio;
+		dom->help_misfit_thr = (ecs && ecs->help_misfit_thr[i] >= 0) ?
+				ecs->help_misfit_thr[i] : dom->def_help_misfit_thr;
+	}
+
+	if (ecs && ecs->has_min_cpus)
+		cpumask_copy(&ecs_dyn.min_cpus, &ecs->min_cpus);
+	else
+		cpumask_copy(&ecs_dyn.min_cpus, &ecs_dyn.def_min_cpus);
+}
+
+static void ecs_dynamic_update_cpus(struct ecs_dyn_domain *dom)
+{
+	unsigned long util_sum = 0, cap_sum = 0;
+	int cpu;
+
+	dom->nr_run = dom->nr_misfit = dom->nr_busy_cpus = 0;
+
+	for_each_cpu(cpu, &dom->cpus) {
+		struct rq *rq = cpu_rq(cpu);
+		unsigned int *avg_nr = per_cpu_ptr(&ecs_dyn_avg_nr, cpu);
+		unsigned int *avg_misfit = per_cpu_ptr(&ecs_dyn_avg_misfit, cpu);
+		unsigned long util, cap, ratio;
+		unsigned int nr, misfit;
+
+		ecs_dyn_avg(avg_nr, READ_ONCE(rq->nr_running) * 1000);
+		ecs_dyn_avg(avg_misfit, READ_ONCE(rq->misfit_task_load) ? 1000 : 0);
+
+		/* only the cpus in use count, as in the S5E9965 */
+		if (!cpu_online(cpu) || !cpumask_test_cpu(cpu, &ecs_gov.cpus))
+			continue;
+
+		cap = capacity_cpu(cpu, USS);
+		util = min(ml_cpu_util(cpu), cap);
+		ratio = cap ? util * 100 / cap : 0;
+		nr = *avg_nr + dom->nr_run_up_ratio;
+		misfit = *avg_misfit + dom->nr_run_up_ratio;
+
+		util_sum += util;
+		cap_sum += cap;
+		dom->nr_run += nr / 1000;
+		dom->nr_misfit += misfit / 1000;
+		if (ratio >= dom->busy_ratio || nr >= ECS_DYN_BUSY_NR_RUN)
+			dom->nr_busy_cpus++;
+
+		trace_ecs_dynamic_cpu_info(cpu, util, cap, ratio,
+				READ_ONCE(rq->nr_running), nr / 1000, misfit / 1000);
+	}
+
+	/* a domain with a spared cpu is never busy: it can still grow */
+	dom->ratio = (dom->has_spared_cpu || !cap_sum) ? 0 : util_sum * 100 / cap_sum;
+	dom->busy = dom->ratio >= dom->busy_ratio;
+}
+
+static void ecs_dynamic_update_domain(int idx, struct cpumask *target)
+{
+	struct ecs_dyn_domain *dom = &ecs_dyn.domains[idx];
+	int i, cpu, nr_help = 0, nr_busy_helpers = 0, nr_misfit = 0, required;
+	bool helper_has_spared_cpu = false;
+
+	for (i = 0; i < dom->nr_nr_help; i++) {
+		struct ecs_dyn_domain *help = &ecs_dyn.domains[dom->nr_help[i]];
+
+		if (help->has_spared_cpu) {
+			helper_has_spared_cpu = true;
+			continue;
+		}
+
+		/* tasks that do not fit in an overpacked smaller domain */
+		nr_help += max(help->nr_run - help->nr_cpus, 0);
+		nr_busy_helpers += help->busy;
+	}
+	if (nr_busy_helpers > 0 && nr_busy_helpers == dom->nr_nr_help)
+		nr_help++;
+	/* a smaller domain uses its own spared cpus first */
+	if (helper_has_spared_cpu)
+		nr_help = 0;
+
+	for (i = 0; i < dom->nr_misfit_help; i++)
+		nr_misfit += ecs_dyn.domains[dom->misfit_help[i]].nr_misfit;
+	if (nr_misfit <= (int)dom->help_misfit_thr)
+		nr_misfit = 0;
+
+	dom->nr_help_cpus = nr_help + nr_misfit;
+
+	if (dom->nr_run >= dom->nr_cpus) {
+		required = dom->nr_cpus;
+	} else {
+		required = dom->nr_busy_cpus + dom->nr_help_cpus;
+		if (required < dom->nr_run)
+			required++;
+	}
+	dom->required_cpus = min(required, dom->nr_cpus);
+
+	required = dom->required_cpus;
+	for_each_cpu_and(cpu, &dom->cpus, cpu_online_mask) {
+		if (required-- <= 0)
+			break;
+		cpumask_set_cpu(cpu, target);
+	}
+
+	trace_ecs_dynamic_domain_info(cpumask_first(&dom->cpus),
+			dom->required_cpus, dom->busy, dom->nr_run, dom->nr_misfit,
+			dom->nr_busy_cpus, dom->nr_help_cpus);
+}
+
+/* Called with ecs_load_lock held. */
+static void ecs_dynamic_update(void)
+{
+	struct cpumask target;
+	unsigned long flags;
+	int i;
+
+	/* once per tick: enqueue and dequeue call ecs_update() too */
+	if (time_before(jiffies, ecs_dyn.last_update + 1))
+		return;
+	ecs_dyn.last_update = jiffies;
+
+	cpumask_andnot(&target, cpu_active_mask, &ecs_gov.cpus);
+	for (i = 0; i < ecs_dyn.nr_domains; i++) {
+		struct ecs_dyn_domain *dom = &ecs_dyn.domains[i];
+
+		dom->has_spared_cpu = cpumask_intersects(&dom->cpus, &target);
+		ecs_dynamic_update_cpus(dom);
+	}
+
+	cpumask_and(&target, &ecs_dyn.min_cpus, cpu_online_mask);
+	for (i = 0; i < ecs_dyn.nr_domains; i++)
+		ecs_dynamic_update_domain(i, &target);
+
+	if (cpumask_empty(&target))
+		cpumask_copy(&target, cpu_online_mask);
+
+	if (cpumask_equal(&target, &ecs_gov.cpus))
+		return;
+
+	spin_lock_irqsave(&ecs_lock, flags);
+	if (ecs_gov.enabled)
