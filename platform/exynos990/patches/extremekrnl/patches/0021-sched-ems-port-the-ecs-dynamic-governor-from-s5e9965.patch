+
+	if (of_property_read_string(dn, "min-cpus", &buf) ||
+	    cpulist_parse(buf, &ecs_dyn.def_min_cpus))
+		goto failure;
+
+	/* first pass: cpus, so that help lists can refer to any domain */
+	for_each_child_of_node(dn, child) {
+		struct ecs_dyn_domain *dom;
+
+		if (i >= ECS_DYN_MAX_DOMAINS)
+			goto failure;
+		dom = &ecs_dyn.domains[i++];
+
+		if (of_property_read_string(child, "cpus", &buf) ||
+		    cpulist_parse(buf, &dom->cpus) || cpumask_empty(&dom->cpus))
+			goto failure;
+		dom->nr_cpus = cpumask_weight(&dom->cpus);
