+		if (of_property_read_string_index(dn, name, i, &buf))
+			return -EINVAL;
+		idx = ecs_dyn_find_domain(buf);
+		if (idx < 0) {
+			pr_warn("ECS: %s: no domain with cpus %s\n", name, buf);
+			return -EINVAL;
+		}
+		help[(*nr_help)++] = idx;
+	}
+
+	return 0;
