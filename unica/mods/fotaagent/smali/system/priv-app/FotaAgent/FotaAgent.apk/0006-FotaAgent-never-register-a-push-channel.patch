+++ b/smali/com/idm/fotaagent/restapi/restclient/push/message/PushType$2.smali
@@ -252,6 +252,12 @@
 .method public isAvailable(Landroid/content/Context;)Z
     .locals 0
 
+    # UN1CA: no push channel (FCM or Samsung SPP) is ever registered.
+    const/4 p0, 0x0
+
+    return p0
+
+
     const/4 p0, 0x1
 
     return p0
