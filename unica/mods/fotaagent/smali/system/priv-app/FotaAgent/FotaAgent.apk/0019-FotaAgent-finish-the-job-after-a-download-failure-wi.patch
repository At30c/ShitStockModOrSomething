From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: At30c <173511395+At30c@users.noreply.github.com>
Date: Mon, 9 Nov 2026 16:11:42 -0300
Subject: [PATCH] FotaAgent: finish the job after a download failure without a
 DM report

A failed download (HTTP error, MD5 mismatch) moves the job to
DOWNLOAD_FAILED_REPORTING (241), whose idmFumoStart starts a DM session
to report the failure. 0002 blocks that session, so it retried forever
with the "connecting to server" notification up, and the pending job
made the ROM update check skip every new check. Close the job locally
as 0017 does after an install result.
---
 ...MFumoExecutorDownloadFailedReporting.smali | 37 ++++++++++++++++---
 1 file changed, 32 insertions(+), 5 deletions(-)

diff --git a/smali/com/idm/fotaagent/enabler/fumo/executor/IDMFumoExecutorDownloadFailedReporting.smali b/smali/com/idm/fotaagent/enabler/fumo/executor/IDMFumoExecutorDownloadFailedReporting.smali
index 9ca2886..815dda6 100644
--- a/smali/com/idm/fotaagent/enabler/fumo/executor/IDMFumoExecutorDownloadFailedReporting.smali
+++ b/smali/com/idm/fotaagent/enabler/fumo/executor/IDMFumoExecutorDownloadFailedReporting.smali
@@ -70,19 +70,46 @@
 .end method
 
 .method public idmFumoStart()V
-    .locals 1
+    .locals 2
 
     const-string v0, ""
 
     invoke-static {v0}, Lcom/samsung/android/fotaagent/common/log/Log;->I(Ljava/lang/Object;)V
 
-    iget-object p0, p0, Lcom/idm/fotaagent/enabler/fumo/executor/IDMFumoExecutor;->actionInfoDao:Lcom/idm/fotaagent/database/sqlite/database/dao/ActionInfoDao;
+    # UN1CA: Samsung DM sessions are blocked, so the session that reports
+    # the download failure never runs: it retried forever and kept the
+    # "connecting to server" notification up, and the pending job blocked
+    # every new check. Close the job the way 0017 does after an install
+    # result: delete the partial package, drop the job's update data and
+    # run IDMFumoTaskDmFinish (cancels the notification, SCHEDULE_FINISH).
+    # The connect/download failure dialog was already shown.
+    new-instance v0, Lcom/idm/fotaagent/utils/storage/FileManager;
+
+    invoke-direct {v0}, Lcom/idm/fotaagent/utils/storage/FileManager;-><init>()V
+
+    invoke-virtual {v0}, Lcom/idm/fotaagent/utils/storage/FileManager;->deleteDeltaAndMetadataFiles()V
+
+    iget-object v1, p0, Lcom/idm/fotaagent/enabler/fumo/executor/IDMFumoExecutor;->context:Landroid/content/Context;
+
+    new-instance v0, Lcom/idm/fotaagent/database/room/data/repository/FotaJobRepository;
+
+    invoke-direct {v0, v1}, Lcom/idm/fotaagent/database/room/data/repository/FotaJobRepository;-><init>(Landroid/content/Context;)V
+
+    invoke-virtual {v0}, Lcom/idm/fotaagent/database/room/data/repository/FotaJobRepository;->resetUpdateInfo()V
+
+    new-instance v0, Lcom/idm/fotaagent/database/room/data/repository/InstallParamRepository;
+
+    invoke-direct {v0, v1}, Lcom/idm/fotaagent/database/room/data/repository/InstallParamRepository;-><init>(Landroid/content/Context;)V
+
+    invoke-virtual {v0}, Lcom/idm/fotaagent/database/room/data/repository/InstallParamRepository;->clear()V
+
+    new-instance v0, Lcom/idm/fotaagent/enabler/fumo/uimanager/taskevent/IDMFumoTaskDmFinish;
 
-    invoke-virtual {p0}, Lcom/idm/fotaagent/database/sqlite/database/dao/ActionInfoDao;->getActionInfo()Lcom/idm/service/actioninfo/IDMActionInfo;
+    iget-object v1, p0, Lcom/idm/fotaagent/enabler/fumo/executor/IDMFumoExecutor;->taskId:Ljava/lang/String;
 
-    move-result-object p0
+    invoke-direct {v0, v1}, Lcom/idm/fotaagent/enabler/fumo/uimanager/taskevent/IDMFumoTaskDmFinish;-><init>(Ljava/lang/String;)V
 
-    invoke-static {p0}, Lcom/idm/fotaagent/LibraryStarter;->startDMTask(Lcom/idm/service/actioninfo/IDMActionInfo;)V
+    invoke-virtual {v0}, Lcom/idm/fotaagent/enabler/fumo/uimanager/IDMFumoTaskCommon;->execute()V
 
     return-void
 .end method
