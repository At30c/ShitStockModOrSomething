+++ b/smali/com/samsung/context/sdk/samsunganalytics/internal/policy/PolicyClient.smali
@@ -665,6 +665,10 @@
 .method public run()V
     .locals 4
 
+    # UN1CA: Samsung Analytics never uploads, registers or fetches policy.
+    return-void
+
+
     :try_start_0
     iget-object v0, p0, Lcom/samsung/context/sdk/samsunganalytics/internal/policy/PolicyClient;->api:Lcom/samsung/context/sdk/samsunganalytics/internal/connection/API;
 
diff --git a/smali/com/samsung/context/sdk/samsunganalytics/internal/sender/DLS/DLSAPIClient.smali b/smali/com/samsung/context/sdk/samsunganalytics/internal/sender/DLS/DLSAPIClient.smali
